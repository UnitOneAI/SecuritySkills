{
  "case": "audit-redaction-overexposes-secrets",
  "description": "An admin audit pipeline logs raw request data to multiple sinks and loses approval context needed for investigation.",
  "producer": "admin-api",
  "event": {
    "action": "support.user_impersonation.start",
    "actorId": "support-17",
    "tenantId": "tenant-a",
    "targetUserId": "user-411",
    "requestHeadersLogged": true,
    "requestBodyLogged": true,
    "authorizationHeader": "Bearer raw-token-value",
    "cookie": "session=raw-session-cookie",
    "resetLink": "https://app.example.test/reset?token=raw-reset-token",
    "approvalId": null,
    "reason": null,
    "policyVersion": null,
    "correlationId": "req-123"
  },
  "sinks": [
    "siem",
    "apm",
    "support-ticket-webhook",
    "data-lake"
  ],
  "controls": {
    "redaction_stage": "after SIEM and APM ingestion",
    "debug_mode": "raw exception serializer enabled",
    "unmask_workflow": "support admins can view raw event payloads without approval",
    "tests": []
  },
  "expected_findings": [
    "FAR-01",
    "FAR-02",
    "FAR-03",
    "FAR-04",
    "FAR-05",
    "FAR-06"
  ]
}
