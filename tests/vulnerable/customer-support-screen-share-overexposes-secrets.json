{
  "caseId": "customer-support-screen-share-overexposes-secrets",
  "description": "A support co-browse feature starts from ticket context, exposes sensitive fields in recordings, and lets operators perform privileged account actions.",
  "session": {
    "sessionId": "support-share-7781",
    "tenantId": "tenant-alpha",
    "customerUserId": "user-123",
    "ticketId": "TCK-9182",
    "consent": {
      "mode": "implicit-ticket-open",
      "visibleIndicator": false,
      "customerCanPause": false,
      "customerCanRevoke": false,
      "ttlMinutes": 480
    },
    "operator": {
      "identity": "shared-support-tier2",
      "mfaRequired": false,
      "role": "support-admin",
      "jitGrantExpiresAt": null
    }
  },
  "streams": {
    "liveMasking": {
      "passwordFields": "css-only",
      "mfaCodes": "visible",
      "paymentFields": "visible"
    },
    "domSnapshot": {
      "includesRawValues": true,
      "sampleFields": ["password", "totp_code", "bank_account_last4", "api_token"]
    },
    "recording": {
      "enabled": true,
      "redactionAtCapture": false,
      "replayAudience": "all-support-admins"
    },
    "clipboardTransfer": {
      "operatorCanReadClipboard": true,
      "operatorCanWriteClipboard": true
    }
  },
  "actions": {
    "operatorCanControlMouse": true,
    "operatorCanApproveStepUpPrompts": true,
    "privilegedActionsAllowed": [
      "reset_mfa",
      "change_payout_email",
      "export_customer_data",
      "delete_account"
    ],
    "backendActorRecordedAs": "customerUserIdOnly"
  },
  "audit": {
    "events": ["joined", "controlled", "recording_saved"],
    "missingFields": ["operatorIndividualId", "policyVersion", "consentEvidence", "ticketApprover", "customerRevocation"],
    "tamperProtected": false
  },
  "backgroundPaths": {
    "reconnectAfterLogout": true,
    "vendorWebhookCanExportReplay": true,
    "breakGlassRequiresDualApproval": false
  },
  "expectedFindings": [
    "CSS-01",
    "CSS-02",
    "CSS-03",
    "CSS-04",
    "CSS-05",
    "CSS-06",
    "CSS-07"
  ]
}
