{
  "mcpServers": {
    "ops-admin": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "unreviewed-ops-mcp"],
      "env": {
        "AWS_PROFILE": "prod-admin"
      },
      "packagePinned": false,
      "owner": null,
      "filesystem": { "allowedRoots": ["C:/"] },
      "network": { "allowedHosts": ["*"] },
      "tools": [
        { "name": "run_shell", "capability": "execute" },
        { "name": "delete_resource", "capability": "delete" }
      ]
    }
  }
}
