`comment("Vulnerable calibration: service accounts are treated like human privileged users")`
index=wineventlog sourcetype="WinEventLog:Security" EventCode=4624
    (TargetUserName="admin*" OR TargetUserName="svc-*" OR TargetUserName="sa-*")
| eval hour = strftime(_time, "%H")
| eval day_of_week = strftime(_time, "%A")
| where (hour < 7 OR hour >= 19)
    OR (day_of_week="Saturday" OR day_of_week="Sunday")
| stats count as logon_count by TargetUserName, LogonType
